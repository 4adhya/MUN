function RotatingEarth() {
  const globeRef = useRef(null);
  const containerRef = useRef(null);
  const [dimensions, setDimensions] = useState({ width: 560, height: 460 });

  useEffect(() => {
    const element = containerRef.current;
    if (!element) return;

    const observer = new ResizeObserver(([entry]) => {
      const width = Math.floor(entry.contentRect.width);
      setDimensions({
        width,
        height: Math.min(510, Math.max(310, Math.floor(width * 0.82))),
      });
    });

    observer.observe(element);
    return () => observer.disconnect();
  }, []);

  useEffect(() => {
    const globe = globeRef.current;
    if (!globe) return;

    const controls = globe.controls();
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.38;
    controls.enableZoom = false;
    controls.enablePan = false;
    globe.pointOfView({ lat: 22, lng: 75, altitude: 2.15 }, 0);
  }, []);

  const arcs = [
    { startLat: 28.6, startLng: 77.2, endLat: 38.9, endLng: -77.0 },
    { startLat: 28.6, startLng: 77.2, endLat: 39.9, endLng: 116.4 },
    { startLat: 48.8, startLng: 2.3, endLat: 35.7, endLng: 139.7 },
    { startLat: 40.7, startLng: -74, endLat: 51.5, endLng: -.1 },
    { startLat: 39.9, startLng: 116.4, endLat: 35.7, endLng: 139.7 },
  ];

  return (
    <button className="mun-scenario-card" onClick={onClick}>
      <span className="mun-scenario-emoji">{scenario.emoji}</span>
      <span className="mun-scenario-level">{scenario.level}</span>
      <h3>{scenario.title}</h3>
      <p>{scenario.description}</p>
      <span className="mun-scenario-committee">
        {scenario.committee}
      </span>
      <span className="mun-card-arrow">Enter crisis →</span>
    </button>
  );
}

function Metric({ icon: Icon, label, value, sub, color = "blue" }) {
  return (
    <div className="metric-card">
      <div className={`metric-icon ${color}`}><Icon size={17} /></div>
      <div className="metric-copy">
        <span>{label}</span><strong>{value}</strong>{sub && <small>{sub}</small>}
      </div>
    </div>
  );
}

function MiniBars({ value, color = "blue" }) {
  return <div className="mini-track"><span className={color} style={{ width: `${value}%` }} /></div>;
}

export default function App() {
  const [screen, setScreen] = useState("landing");
  const [countryName, setCountryName] = useState("India");
  const [tab, setTab] = useState("dashboard");
  const [modal, setModal] = useState("");
  const [target, setTarget] = useState("China");
  const [reason, setReason] = useState("Economic");
  const [events, setEvents] = useState(initialEvents);
  const [actionResult, setActionResult] = useState(null);
  const [query, setQuery] = useState("");
  const [advisorQuestion, setAdvisorQuestion] = useState("");
  const [showAdvisor, setShowAdvisor] = useState(false);
  const [notice, setNotice] = useState("");
  const [turn, setTurn] = useState(1);

  const country = countries.find((c) => c.name === countryName) || countries[0];
  const targetCountry = countries.find((c) => c.name === target) || countries[2];
  const filteredCountries = countries.filter((c) => c.name.toLowerCase().includes(query.toLowerCase()));

  function openGame() {
    setScreen("select");
    setNotice("");
  }

  function enterGame() {
    setScreen("game");
    setTab("dashboard");
    setEvents([
      { type: "alert", title: "Regional trade tensions", detail: `${country.name} is reviewing its diplomatic position amid rising tensions.`, time: "Just now" },
      ...initialEvents.slice(1),
    ]);
  }

  if (!profile) {
    return (
      <PageTransition key="entry">
        <NameEntry onEnter={handleEnter} />
      </PageTransition>
    );
  }

  return (
    <PageTransition key="dashboard">
      <Dashboard
        profile={profile}
        onChangeProfile={handleChangeProfile}
      />
    </PageTransition>
  );
}

function ZapIcon(props) {
  return <Activity {...props} />;
}
